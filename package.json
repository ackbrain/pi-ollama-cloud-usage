{
  "name": "pi-ollama-cloud-usage",
  "version": "1.0.1",
  "description": "Pi extension that shows Ollama Cloud quota usage in the status line",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ollama",
    "ollama-cloud",
    "usage",
    "quota",
    "status-line"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puetsua/pi-ollama-cloud-usage.git"
  },
  "homepage": "https://github.com/puetsua/pi-ollama-cloud-usage#readme",
  "bugs": {
    "url": "https://github.com/puetsua/pi-ollama-cloud-usage/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
